#!/usr/sbin/nft -f
# Host inbound filter: default-deny, SSH only from the management sets.
# Distro-neutral (nftables 1.0.2+: Ubuntu 22.04, Debian 12, RHEL 9).
#
# Load:     nft -c -f host-filter.nft && nft -f host-filter.nft
# Persist:  Debian/Ubuntu: include it from /etc/nftables.conf
#           RHEL/Rocky:    include it from /etc/sysconfig/nftables.conf
#           then `systemctl enable nftables`.
#
# This file owns ONE table and never runs `flush ruleset`, so it coexists with
# Docker, Kubernetes CNIs, fail2ban and libvirt, which keep their own tables.
# It filters only the input hook: forwarded (container/VM) traffic is not
# touched. If firewalld or ufw is also active, a packet must be accepted by
# every base chain on the hook; run one host firewall, not two.
#
# REPLACE the documentation prefixes in the mgmt sets before loading, or you
# lock yourself out. The rollout section of guides/linux-hardening.md has a
# timed auto-revert procedure.

# Declaring then deleting the table makes the file idempotent and atomic:
# the whole file is one transaction, so a syntax error changes nothing.
table inet host_filter
delete table inet host_filter

table inet host_filter {
    # Bastions / VPN egress / CI runners allowed to reach sshd.
    set mgmt_v4 {
        type ipv4_addr
        flags interval
        elements = { 192.0.2.0/24 }
    }

    set mgmt_v6 {
        type ipv6_addr
        flags interval
        elements = { 2001:db8::/32 }
    }

    chain input {
        type filter hook input priority filter; policy drop;

        ct state established,related accept
        ct state invalid drop

        iif "lo" accept
        # Loopback addresses arriving on a real interface are spoofed.
        iif != "lo" ip daddr 127.0.0.0/8 drop
        iif != "lo" ip6 daddr ::1 drop

        # ICMP errors for existing flows are already "related". Echo is rate
        # limited; do not drop ICMP wholesale (breaks PMTU discovery).
        ip protocol icmp icmp type echo-request limit rate 10/second accept
        ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept

        # IPv6 does not work without neighbour discovery and packet-too-big.
        # "icmpv6" is an nft keyword; the protocol name "ipv6-icmp" is resolved
        # through /etc/protocols, which minimal images do not ship.
        meta l4proto icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta l4proto icmpv6 icmpv6 type echo-request limit rate 10/second accept

        # DHCP replies are not "related" to the request: they arrive from a
        # different address than the broadcast/multicast request went to. Drop
        # these two rules only on hosts with a static address, or the lease
        # renewal that happens hours after rollout is what locks you out.
        udp sport 67 udp dport 68 accept
        ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept

        tcp dport 22 ip saddr @mgmt_v4 ct state new accept
        tcp dport 22 ip6 saddr @mgmt_v6 ct state new accept

        # Add service ports here, e.g.:
        # tcp dport { 80, 443 } ct state new accept
        # tcp dport 9100 ip saddr @mgmt_v4 ct state new accept

        limit rate 5/minute burst 10 packets log prefix "nft-input-drop: " level info
        counter comment "dropped by policy"
    }
}
