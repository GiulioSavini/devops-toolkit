// Install as /etc/apt/apt.conf.d/20auto-upgrades (Debian 12, Ubuntu 22.04/24.04).
// Same content `dpkg-reconfigure -plow unattended-upgrades` writes, plus a
// weekly autoclean. Run by apt-daily.timer / apt-daily-upgrade.timer
// (06:00 plus a random delay of up to 60 minutes by default).
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
