# /etc/restic/restic.env — root-owned, mode 0400. Loaded by the systemd units.
#
# Every value here is an example. The repository password and the credentials
# are NOT in this file: the password is read from a file, and the object-store
# credentials come from an instance role or a workload identity, not from keys
# pasted in here. See guides/secrets-management.md.

# Where the repository lives. s3: works with S3, and with any S3-compatible
# store (MinIO, Backblaze B2's S3 endpoint, Wasabi, Ceph RGW).
RESTIC_REPOSITORY=s3:s3.eu-west-1.amazonaws.com/example-org-backups/host01

# The password is read from this file, never from RESTIC_PASSWORD. An inline
# password is readable in /proc/<pid>/environ, appears in `systemctl show`, and
# ends up in journald.
#
# LOSING THIS PASSWORD LOSES THE BACKUPS. There is no recovery path: restic
# encrypts client-side and nobody, including the storage provider, can decrypt
# without it. Store it in a password manager AND print it into a sealed envelope
# in a different building. Back it up somewhere that does not depend on this
# repository.
RESTIC_PASSWORD_FILE=/etc/restic/password

# What to back up. Space-separated. --one-file-system in the wrapper stops each
# of these from wandering into a mounted network share.
BACKUP_PATHS=/etc /home /srv /var/lib

BACKUP_EXCLUDE_FILE=/etc/restic/excludes.txt
BACKUP_TAG=scheduled

# Retention. Read this as "what must still be restorable", not as "how long we
# keep things": each flag keeps the LAST snapshot in each period, so
# --keep-daily 14 does not mean 14 snapshots if the host was off for a week.
RETENTION_ARGS=--keep-daily 14 --keep-weekly 8 --keep-monthly 12 --keep-yearly 3

# How much real data to re-read per run. 5% daily reads the whole repository
# roughly every three weeks, which is how you find bit rot before a restore does.
CHECK_SUBSET=5%

# 0 = never remove a repository lock automatically. Raise it only to a value
# safely longer than the longest run you have ever seen: a lock removed while
# another process holds it means two writers on one repository.
STALE_LOCK_MINUTES=0

# S3 credentials: DO NOT PUT KEYS HERE. Attach an instance profile / managed
# identity / service account instead, and let the SDK pick it up. If you truly
# have no other option, put the keys in a separate root-owned 0400 file and add
# a second EnvironmentFile= line, so this file can stay in configuration
# management and that one cannot.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
