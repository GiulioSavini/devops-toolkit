#!/usr/sbin/nft -f
# Install as /etc/nftables.conf on the WireGuard hub, load with
# `systemctl enable --now nftables.service`, validate before loading with
# `nft -c -f /etc/nftables.conf`.
#
# Default-deny on all three base chains. Without this file the hub in
# guides/network-zero-trust.md has WireGuard's own crypto as its only access
# control — AllowedIPs stops off-tunnel traffic, but every other port
# (management SSH, any service accidentally bound to 0.0.0.0) is reachable
# from the internet. See the guide for the rollout order (log-only first).
#
# This file owns ONE table (inet wg_hub) and never runs `flush ruleset`, for
# the same reason baselines/linux/nftables/host-filter.nft does not: a global
# flush also deletes Docker's and Kubernetes CNI's own tables, and on a
# WireGuard hub that also runs containers that breaks their networking until
# the daemon reprograms it. Declaring then deleting the table makes the file
# idempotent and the load one atomic transaction: a syntax error changes
# nothing. tests/network.sh loads this file in a real netns and asserts the
# table survives under its own name rather than via a ruleset-wide flush.

table inet wg_hub
delete table inet wg_hub

table inet wg_hub {
	# Replace with your actual bastion/jump host address(es) — see the
	# "Threat model" section of the guide.
	set mgmt_bastion {
		type ipv4_addr
		flags interval
		elements = { 203.0.113.10 }
	}

	# One pair of sets PER SITE, not one shared set for every site. A
	# single "tunnel peers" / "routed sites" set pair looks tidy but
	# collapses every spoke into the same forwarding decision: with only
	# one set on each side, site A's tunnel address matches @tunnel_peers
	# and site B's LAN matches @routed_sites, so site A can reach site B
	# through the hub even though they are unrelated WireGuard peers. The
	# per-site sets below are what makes "site A cannot reach site B"
	# actually true instead of merely commented as true.
	set site_a_tunnel {
		type ipv4_addr
		elements = { 10.100.0.2 }
	}

	set site_a_lan {
		type ipv4_addr
		flags interval
		elements = { 192.168.10.0/24 }
	}

	set site_b_tunnel {
		type ipv4_addr
		elements = { 10.100.0.3 }
	}

	set site_b_lan {
		type ipv4_addr
		flags interval
		elements = { 192.168.20.0/24 }
	}

	# Egress allowlist for the hub's own outbound traffic (not forwarded
	# traffic — see the forward chain). Package mirrors, monitoring
	# endpoint, etc. Empty destination sets fail closed: forgetting to add
	# a destination here is a timeout, not a silent bypass.
	# Starts empty on purpose (nftables rejects `elements = { }`; an empty
	# set is simply declared with no elements line). Populate it from your
	# own change record before relying on the output chain's default-deny
	# — until then, everything through this rule times out.
	set egress_v4 {
		type ipv4_addr
		flags interval
	}

	set dns_resolvers {
		type ipv4_addr
		elements = { 9.9.9.9, 149.112.112.112 }
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif lo accept
		ct state established,related accept
		ct state invalid drop comment "no state table entry: neither a new nor a tracked connection"

		icmp type { echo-request, destination-unreachable, time-exceeded } accept
		icmpv6 type { echo-request, destination-unreachable, time-exceeded, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept

		udp dport 51820 accept comment "WireGuard listener — this is the only port that should be open to the whole internet"

		# Defense in depth: source restriction AND a rate limit. The
		# source restriction is the real control; the rate limit only
		# helps if the bastion's own key is compromised.
		tcp dport 22 ip saddr @mgmt_bastion ct state new limit rate 15/minute accept comment "SSH mgmt, bastion only"

		counter log prefix "nft-input-drop: " drop
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop

		# One pair of rules per site: tunnel peer -> its own LAN for new
		# connections, and the reverse leg for connections the LAN side
		# initiates back into the tunnel. Do not collapse these into a
		# single "wg0 in, wg0 out" rule using shared sets — see the
		# comment on site_a_tunnel above for what that actually does.
		iifname "wg0" oifname != "wg0" ip saddr @site_a_tunnel ip daddr @site_a_lan ct state new accept comment "site A tunnel -> site A LAN"
		iifname != "wg0" oifname "wg0" ip daddr @site_a_tunnel ct state new accept comment "site A LAN -> site A tunnel (reply path for site-initiated connections)"

		iifname "wg0" oifname != "wg0" ip saddr @site_b_tunnel ip daddr @site_b_lan ct state new accept comment "site B tunnel -> site B LAN"
		iifname != "wg0" oifname "wg0" ip daddr @site_b_tunnel ct state new accept comment "site B LAN -> site B tunnel (reply path for site-initiated connections)"

		counter log prefix "nft-forward-drop: " drop
	}

	chain output {
		type filter hook output priority filter; policy drop;

		oif lo accept
		ct state established,related accept

		udp dport 51820 accept comment "WireGuard to spokes"
		udp dport 123 accept comment "NTP — see 'Time sync' in observability-logging.md, correlation and TLS both depend on it"

		udp dport 53 ip daddr @dns_resolvers accept
		tcp dport 53 ip daddr @dns_resolvers accept comment "TCP fallback for large/DNSSEC responses"

		tcp dport { 80, 443 } ip daddr @egress_v4 accept comment "explicit egress allowlist, not a blanket 80/443-to-anywhere rule"

		counter log prefix "nft-output-drop: " drop
	}
}
